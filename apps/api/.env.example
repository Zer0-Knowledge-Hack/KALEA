PORT=8787
WEB_ORIGIN=http://localhost:3000
HOME_DOMAIN=localhost
STELLAR_NETWORK=testnet
# Stellar secret (S...) used to sign merchant SEP-10 challenges
SERVER_SIGNING_SECRET=
JWT_SECRET=

# Integrator API keys as comma-separated <integratorId>:<key> pairs (keys >= 24 chars).
# Keys are SHA-256 hashed at startup; only the hashes are kept in memory. Generate one with:
#   node -e "console.log('kalea_' + require('crypto').randomBytes(24).toString('hex'))"
# Demo integrator ids: int_wallet, int_payments. Unset = no integrator can authenticate.
INTEGRATOR_API_KEYS=
# Merchants allowed to log in via SEP-10, as comma-separated <merchantId>:<G... account> pairs.
# Demo merchant ids: mer_andes, mer_rio, mer_azteca.
MERCHANT_ACCOUNTS=
