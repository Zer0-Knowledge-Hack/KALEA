---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Kalea · B2B fiat <-> USDC ramps for LATAM on Stellar",
  description = "Ramp infrastructure for businesses: embed local fiat <-> USDC on-ramps, off-ramps and QR payments across Latin America with one API, settled in USDC on Stellar.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Schibsted+Grotesk:wght@400;500;600;700&display=swap"
    />
    <!-- Marks the page as scripted so reveal-on-scroll styles apply only when JavaScript runs. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body class="font-sans antialiased">
    <slot />
  </body>
</html>
