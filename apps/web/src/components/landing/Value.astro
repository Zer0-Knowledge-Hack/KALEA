---
import type { Rail } from "@kalea/shared";
import { RAILS, RAIL_NAMES } from "../../lib/catalog";
import Highlight from "../ornaments/Highlight.astro";
import LaneUnderline from "../ornaments/LaneUnderline.astro";
import RoadArrow from "../ornaments/RoadArrow.astro";
import { container, eyebrowLight, h2, sectionY } from "./styles";

// The best-known rails first; only rails a demo corridor already uses are listed.
const featured: Rail[] = ["pix", "spei", "yape", "qr_simple", "bank_transfer"];
const liveRails = featured.filter((rail) => RAILS.some((r) => r.rail === rail && r.live)).map((rail) => RAIL_NAMES[rail]);
const formatList = (items: string[]) => new Intl.ListFormat("en", { type: "conjunction" }).format(items);

const copy = {
  eyebrow: "Product",
  headline: ["Ramps as a", "feature,", "not a project."],
  subBefore: "Move money in and out of stablecoins with",
  subKey: "one integration",
  subAfter: ".",
  audienceLabel: "Built for",
};
// Each road marking says what the statement does: one straight path, many local routes, one turn on-chain.
const statements = [
  { arrow: "straight", title: "One API", body: "On-ramp, off-ramp and QR payments. Payouts next." },
  { arrow: "split", title: "Local rails", body: `${formatList(liveRails)}.` },
  { arrow: "turn", title: "Stablecoin settlement", body: "Fixed all-in quotes, settled on-chain." },
] as const;
const audiences = ["Wallets & exchanges", "Fintechs & neobanks", "PSPs & payment apps", "Marketplaces & platforms"];
---

<section id="product" class="bg-white text-ink">
  <div class:list={[container, sectionY]}>
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class={eyebrowLight}>{copy.eyebrow}</p>
        <h2 class:list={[h2, "mt-5"]}>{copy.headline[0]} <Highlight>{copy.headline[1]}</Highlight><br class="hidden sm:block" /> {copy.headline[2]}</h2>
      </div>
      <p class="max-w-sm text-lg text-ink/75 lg:col-span-4 lg:col-start-9">
        {copy.subBefore} <LaneUnderline>{copy.subKey}</LaneUnderline>{copy.subAfter}
      </p>
    </div>

    <ol class="mt-20 grid gap-12 sm:grid-cols-3 sm:gap-8">
      {statements.map((s, i) => (
        <li data-reveal style={`--delay:${i * 0.08}s`} class="border-t border-ink pt-6">
          <div class="flex items-start justify-between">
            <span class="font-mono text-xs text-muted">0{i + 1}</span>
            <RoadArrow kind={s.arrow} class="size-12 text-ocean" />
          </div>
          <h3 class="mt-6 text-2xl sm:mt-10 font-semibold tracking-tight">{s.title}</h3>
          <p class="mt-2 max-w-[28ch] text-ink/75">{s.body}</p>
        </li>
      ))}
    </ol>

    <div class="mt-20 grid gap-4 border-t border-line pt-6 lg:grid-cols-12">
      <p class:list={[eyebrowLight, "lg:col-span-3"]}>{copy.audienceLabel}</p>
      <ul class="flex flex-wrap gap-x-10 gap-y-3 font-display text-xl font-semibold tracking-tight sm:text-2xl lg:col-span-9">
        {audiences.map((a) => <li>{a}</li>)}
      </ul>
    </div>
  </div>
</section>
