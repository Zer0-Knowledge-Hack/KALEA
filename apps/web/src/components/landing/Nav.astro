---
import { Logo } from "../logo";
import { CONTACT_URL } from "./styles";

const links = [
  ["Product", "#product"],
  ["How it works", "#how-it-works"],
  ["Coverage", "#coverage"],
  ["Developers", "#developers"],
  ["Pricing", "#pricing"],
  ["FAQ", "#faq"],
];
const cta = "Book a demo";
const menuLabel = "Menu";
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 border-b border-deep-line bg-deep/95 backdrop-blur-lg transition-transform duration-300 ease-[cubic-bezier(.22,1,.36,1)]"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" aria-label="Kalea home"><Logo tone="on-dark" /></a>
    <ul class="hidden gap-7 lg:flex">
      {links.map(([t, h]) => (
        <li>
          <a href={h} class="text-sm text-deep-soft transition hover:text-white">{t}</a>
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-3">
      <a href={CONTACT_URL} class="rounded-[6px] border border-white/40 px-4 py-2 text-sm font-semibold text-white transition hover:border-white">{cta}</a>
      <button
        id="nav-toggle"
        aria-label={menuLabel}
        aria-expanded="false"
        aria-controls="nav-menu"
        class="group grid size-9 place-items-center rounded-[6px] border border-deep-line lg:hidden"
      >
        <span class="relative block h-3 w-4">
          <span class="absolute left-0 top-0 h-px w-4 bg-surface transition-transform group-aria-expanded:translate-y-[5px] group-aria-expanded:rotate-45"></span>
          <span class="absolute bottom-0 left-0 h-px w-4 bg-surface transition-transform group-aria-expanded:-translate-y-[6px] group-aria-expanded:-rotate-45"></span>
        </span>
      </button>
    </div>
  </nav>
  <ul id="nav-menu" hidden class="px-4 lg:hidden">
    {links.map(([t, h], i) => (
      <li class="fade-up border-t border-deep-line first:border-0" style={`animation-delay:${0.05 * i}s`}>
        <a href={h} class="block py-4 text-2xl font-semibold">{t}</a>
      </li>
    ))}
  </ul>
</header>
