---
import { Logo } from "../logo";

const links = [
  ["How it works", "#how-it-works"],
  ["Coverage", "#coverage"],
  ["Pricing", "#pricing"],
  ["Merchants", "#merchants"],
  ["FAQ", "#faq"],
];
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 transition-[transform,background-color,border-color] duration-300 ease-[cubic-bezier(.22,1,.36,1)] data-[solid]:border-b data-[solid]:border-deep-line data-[solid]:bg-deep/90 data-[solid]:backdrop-blur-lg"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" aria-label="Kalea home"><Logo /></a>
    <ul class="hidden gap-7 md:flex">
      {links.map(([t, h]) => (
        <li>
          <a href={h} class="font-mono text-[11px] uppercase tracking-[0.14em] text-deep-soft transition hover:text-apricot">{t}</a>
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-2">
      <a href="/app" class="hidden font-mono text-[11px] uppercase tracking-[0.14em] text-deep-soft hover:text-surface sm:block">Merchant login</a>
      <a href="#contact" class="rounded-full bg-apricot px-4 py-2 font-mono text-xs font-semibold uppercase tracking-wider text-ink transition hover:brightness-110">Talk to us</a>
      <button
        id="nav-toggle"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="nav-menu"
        class="group grid size-9 place-items-center rounded-full border border-deep-line md:hidden"
      >
        <span class="relative block h-3 w-4">
          <span class="absolute left-0 top-0 h-px w-4 bg-surface transition-transform group-aria-expanded:translate-y-[5px] group-aria-expanded:rotate-45"></span>
          <span class="absolute bottom-0 left-0 h-px w-4 bg-surface transition-transform group-aria-expanded:-translate-y-[6px] group-aria-expanded:-rotate-45"></span>
        </span>
      </button>
    </div>
  </nav>
  <ul id="nav-menu" hidden class="px-4 md:hidden">
    {[...links, ["Merchant login", "/app"]].map(([t, h], i) => (
      <li class="fade-up border-t border-deep-line first:border-0" style={`animation-delay:${0.05 * i}s`}>
        <a href={h} class="block py-4 text-2xl font-semibold">{t}</a>
      </li>
    ))}
  </ul>
</header>
