---
/**
 * Typographic status: a short rule plus a mono word. Live uses a solid rule, next a dashed one,
 * so the status never relies on color alone. No pill, no box.
 */
interface Props {
  live: boolean;
  tone?: "light" | "dark";
  /** Visible, localized text ("Live" or "Next" in the page language). */
  label: string;
}

const { live, tone = "light", label } = Astro.props;
const color = tone === "light" ? (live ? "text-ocean" : "text-muted") : live ? "text-apricot" : "text-deep-muted";
---

<span class:list={["inline-flex items-center gap-2 whitespace-nowrap font-mono text-[11px] uppercase tracking-[0.2em]", color]}>
  <span aria-hidden="true" class:list={["w-4 border-t border-current", { "border-dashed": !live }]}></span>
  {label}
</span>
