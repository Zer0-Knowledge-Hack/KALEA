---
import { DEFAULT_MERCHANT_REWARD_BPS } from "@kalea/shared";
import { eyebrow } from "./styles";

const rewardPct = DEFAULT_MERCHANT_REWARD_BPS / 100;
const pillars = [
  ["Your accounts, your fiat", "You receive and send local fiat through your own bank, wallet or QR accounts. Kalea never holds local fiat."],
  [`${rewardPct}% on every order`, "Each released order credits a reward to your vault, shown on the receipt as a separate line next to the exact order amounts."],
  ["7-day reward cycles", "Rewards unlock after a 7-day cycle, which protects every party against fraud and rewards steady liquidity."],
  ["Escrow before fiat", "USDC is held by the order's escrow contract under its rules before anyone sends fiat, and released only on confirmation or refunded on timeout."],
];
---

<section id="merchants" class="mx-auto max-w-6xl px-4 py-28 sm:px-6">
  <p class={eyebrow}>For merchants / liquidity providers</p>
  <h2 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight sm:text-5xl">Provide liquidity. Earn on every order.</h2>
  <div class="mt-14 grid gap-4 sm:grid-cols-2">
    {pillars.map(([t, d], i) => (
      <div
        data-reveal
        data-spotlight
        style={`--from:scale(.94);--delay:${i * 0.08}s`}
        class="rounded-3xl border border-deep-line bg-[radial-gradient(320px_circle_at_var(--x,-999px)_var(--y,-999px),rgba(238,158,79,.12),transparent_60%)] p-6 transition-colors hover:border-apricot/40 sm:p-7"
      >
        <span class="font-mono text-xs text-apricot">0{i + 1}</span>
        <h3 class="mt-6 text-xl font-semibold">{t}</h3>
        <p class="mt-2 text-sm leading-relaxed text-deep-soft">{d}</p>
      </div>
    ))}
  </div>
  <a href="/app" class="mt-10 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.14em] text-deep-soft hover:text-apricot">Merchant dashboard →</a>
</section>
