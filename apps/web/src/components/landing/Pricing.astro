---
import { DEFAULT_MERCHANT_REWARD_BPS } from "@kalea/shared";
import HeroNumber from "../ornaments/HeroNumber.astro";
import { eyebrowLight } from "./styles";

const rewardPct = DEFAULT_MERCHANT_REWARD_BPS / 100;
const rows: [string, string, string][] = [
  ["End user", "One all-in price", "No Kalea fee line"],
  ["Integrator", "Per-transaction fee", "Debited from a prefunded USDC balance"],
  ["Merchant", `Earns ${rewardPct}% per order`, "Locked in 7-day cycles"],
  ["Insurance fund", "About 0.1% per order", "Funded from the spread"],
];
// The integrator is the only party that pays Kalea, so its card is the featured one.
const FEATURED = "Integrator";
---

<section id="pricing" class="bg-surface text-ink">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-24 sm:px-6 sm:py-28 lg:grid-cols-[1fr_1.3fr]">
    <div>
      <p class={eyebrowLight}>Pricing</p>
      <h2 class="mt-4 text-4xl font-bold tracking-tight">Only integrators pay Kalea.</h2>
      <p class="mt-5 text-ink/75">Prices are set per country and side over a market reference rate. The spread funds the merchant reward and the insurance fund. You can add your own markup on top.</p>
      <div class="mt-10 grid grid-cols-2 gap-6">
        <HeroNumber label="merchant reward per order"><span data-count={rewardPct} data-decimals="1" data-suffix="%">{rewardPct.toFixed(1)}%</span></HeroNumber>
        <HeroNumber label="day reward lock cycle"><span data-count="7">7</span></HeroNumber>
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {rows.map(([l, a, b], i) => {
        const featured = l === FEATURED;
        return (
          <div data-reveal style={`--from:translateY(10px);--delay:${0.1 * i}s`} class:list={["cut-tr p-6", featured ? "bg-ocean text-white" : "bg-white text-ink"]}>
            <p class:list={["font-mono text-[11px] uppercase tracking-[0.14em]", featured ? "text-ocean-100" : "text-muted"]}>{l}</p>
            <p class="mt-4 text-lg font-semibold">{a}</p>
            <span aria-hidden="true" class:list={["mt-3 block h-[3px] w-10 rounded-full", featured ? "bg-apricot" : "bg-line"]}></span>
            <p class:list={["mt-3 text-sm", featured ? "text-ocean-100" : "text-ink/75"]}>{b}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>
