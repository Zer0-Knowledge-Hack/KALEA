---
import Merge from "../ornaments/Merge.astro";
import { container, eyebrowLight, h2, sectionY } from "./styles";

const copy = {
  eyebrow: "How it works",
  headline: "Escrow-first. Fiat stays local.",
  safetyLabel: "Safety",
  mergeFiat: "Fiat · local rails",
  mergeCoin: "Stablecoin · on-chain",
  mergeOrder: "One order",
  note: "Testnet today: the escrow lifecycle is simulated while the on-chain contract is built.",
};
const steps = [
  ["Quote", "Request a fixed all-in quote by country, side, rail and amount. Valid for 5 minutes."],
  ["Lock", "Kalea matches an independent local liquidity partner and locks the stablecoins in escrow."],
  ["Pay locally", "Fiat moves over Pix, SPEI, Yape, QR Simple or bank transfer, between your user and the partner."],
  ["Release", "On confirmation the escrow releases the stablecoins. Your fee comes from your prefunded balance."],
];
const safety = [
  "Fiat never touches Kalea.",
  "Every order gets its own escrow with fixed amounts.",
  "Disputes freeze the escrow; an insurance fund covers resolved losses.",
];
---

<section id="how-it-works" class="bg-surface text-ink">
  <div class:list={[container, sectionY]}>
    <p class={eyebrowLight}>{copy.eyebrow}</p>
    <h2 class:list={[h2, "mt-5 max-w-3xl"]}>{copy.headline}</h2>

    <!-- The route is the layout: a dashed lane with one stop per step, ending in the Apricot release. -->
    <ol class="relative mt-20 grid gap-12 border-l-2 border-dashed border-ocean pl-8 lg:grid-cols-4 lg:gap-10 lg:border-l-0 lg:border-t-2 lg:pl-0">
      {steps.map(([t, d], i) => {
        const last = i === steps.length - 1;
        return (
          <li data-reveal style={`--delay:${i * 0.08}s`} class="relative lg:pt-12">
            {/* Stop on the route: a ring for each step, an Apricot marker for the release. */}
            <span
              aria-hidden="true"
              class:list={[
                "absolute -left-[41px] top-1 size-4 lg:-top-[9px] lg:left-0",
                last ? "bg-apricot [clip-path:polygon(50%_0,100%_100%,0_100%)]" : "rounded-full border-[3px] border-ocean bg-surface",
              ]}
            ></span>
            <span class="font-mono text-xs text-muted">0{i + 1}</span>
            <h3 class="mt-3 text-2xl font-semibold tracking-tight">{t}</h3>
            <p class="mt-2 max-w-[30ch] text-ink/75">{d}</p>
          </li>
        );
      })}
    </ol>

    <div class="mt-24 grid gap-12 border-t border-line pt-10 lg:grid-cols-12 lg:items-center">
      <figure class="relative my-6 lg:col-span-5">
        <Merge class="block w-full max-w-md" />
        <figcaption class="pointer-events-none absolute inset-0 max-w-md font-mono text-[11px] uppercase tracking-[0.16em] text-muted">
          <span class="absolute left-0 top-0 -translate-y-full pb-1">{copy.mergeFiat}</span>
          <span class="absolute bottom-0 left-0 translate-y-full pt-1">{copy.mergeCoin}</span>
          <span class="absolute right-0 top-1/2 -translate-y-[180%] text-ocean">{copy.mergeOrder}</span>
        </figcaption>
      </figure>
      <div class="lg:col-span-6 lg:col-start-7">
        <p class={eyebrowLight}>{copy.safetyLabel}</p>
        <ul class="mt-4 divide-y divide-line border-y border-line">
          {safety.map((s) => <li class="py-3.5 text-lg">{s}</li>)}
        </ul>
        <p class="mt-5 text-sm text-muted">{copy.note}</p>
      </div>
    </div>
  </div>
</section>
