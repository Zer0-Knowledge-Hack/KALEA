---
import { eyebrow } from "./styles";

const steps = [
  ["Quote", "Your backend requests a quote for a country, side (on-ramp or off-ramp), rail and amount. Your end user sees one all-in price."],
  ["Match and lock", "You create the order and Kalea matches it with a merchant. The USDC side is locked in a per-order Soroban escrow with fixed amounts before any fiat moves."],
  ["Fiat moves locally", "The end user and the merchant exchange local fiat over Pix, SPEI, Yape, QR Simple or a bank transfer, under the merchant's own accounts. Kalea never holds local fiat."],
  ["Release", "Once the fiat recipient confirms, the escrow releases USDC, credits the merchant reward and the insurance fund, and Kalea debits your fee from your prefunded balance."],
];
---

<section id="how-it-works" class="border-t border-deep-line bg-deep-2/40">
  <div class="mx-auto max-w-6xl px-4 py-28 sm:px-6">
    <p class={eyebrow}>How it works</p>
    <h2 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight sm:text-5xl">Escrow-first. Fiat stays local. Kalea settles only USDC.</h2>
    <div class="relative mt-16 pl-10 sm:pl-14">
      <div class="absolute left-3 top-0 h-full w-px bg-deep-line sm:left-5"></div>
      <div class="rail-progress absolute left-3 top-0 h-full w-px bg-apricot shadow-[0_0_12px_var(--color-apricot)] sm:left-5"></div>
      <ol class="space-y-14">
        {steps.map(([t, d], i) => (
          <li class="relative" data-reveal="dim" data-reveal-repeat>
            <span class="absolute -left-10 top-1 grid size-7 place-items-center rounded-full border border-apricot bg-deep font-mono text-[11px] text-apricot sm:-left-14">{i + 1}</span>
            <h3 class="text-2xl font-semibold">{t}</h3>
            <p class="mt-2 max-w-xl text-deep-soft">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
