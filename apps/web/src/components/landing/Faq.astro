---
import CrownDivider from "../ornaments/CrownDivider.astro";
import { container, eyebrowLight, h2, sectionY } from "./styles";

const copy = { eyebrow: "FAQ", headline: "Questions, answered.", topics: "FAQ topics" };

// Integrator-facing only. Liquidity partners get their own surface later.
const groups: { id: string; title: string; faqs: [string, string][] }[] = [
  {
    id: "businesses",
    title: "Businesses",
    faqs: [
      ["Who is Kalea for?", "Businesses that want local on-ramps, off-ramps or QR payments in their product: wallets, exchanges, fintechs, payment apps, marketplaces and platforms. Kalea does not serve consumers directly."],
      ["Which networks and stablecoins do you support?", "Today, USDC on the Stellar testnet. Kalea is built to support USDC and USDT across EVM networks (Ethereum, Base, Polygon, Arbitrum, BNB Chain) and non-EVM networks (Solana, Tron); those are next."],
      ["Which countries are covered?", "Bolivia, Brazil, Peru and Mexico have demo pricing on testnet. Argentina, Colombia, Chile and Ecuador are planned."],
      ["Does Kalea hold my users' money?", "Kalea never holds local fiat; it moves over local rails between your end user and an independent local liquidity partner. Stablecoins are held by a per-order escrow until the order is released, refunded or resolved."],
      ["Can I use Kalea with real funds today?", "Not yet. Kalea runs on testnet with demo pricing. Licensing requirements will be assessed per country before operating with real funds."],
    ],
  },
  {
    id: "developers",
    title: "Developers",
    faqs: [
      ["How do I integrate?", "Your backend calls the REST API with an API key: list corridors, request a quote, create an order and follow it to release. The public demo quote endpoint needs no key."],
      ["Can I accept QR payments?", "Yes. A QR payment is an off-ramp variant: create a sell order with kind qr_payment and the QR payload. Your end user locks stablecoins and the third-party QR is paid in local currency."],
      ["Do you offer webhooks or an SDK?", "Not yet; both are next. Today you read an order's status from the orders endpoint."],
    ],
  },
];
---

<section id="faq" class="bg-surface text-ink">
  <div class:list={[container, sectionY]}>
    <CrownDivider class="text-line" />
    <div class="mt-16 grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class={eyebrowLight}>{copy.eyebrow}</p>
        <h2 class:list={[h2, "mt-5"]}>{copy.headline}</h2>
      </div>
      <!-- Without JavaScript every group is shown with its heading; landing.ts turns the groups into tabs. -->
      <div data-tabs class="min-w-0 lg:col-span-8">
        <div data-tablist aria-label={copy.topics} hidden class="flex gap-8 border-b border-line">
          {groups.map((g) => (
            <button type="button" id={`faq-tab-${g.id}`} aria-controls={`faq-${g.id}`} class="faq-tab -mb-px border-b-2 border-transparent pb-3 text-[15px] font-semibold text-ink/70 transition-colors hover:text-ink aria-selected:border-ocean aria-selected:text-ink">
              {g.title}
            </button>
          ))}
        </div>
        {groups.map((g, gi) => (
          <div id={`faq-${g.id}`} data-tabpanel class:list={[{ "mt-12": gi > 0 }, "[.tabs-on_&]:mt-0"]}>
            <h3 data-tabheading class="pb-3 font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-ocean">{g.title}</h3>
            <div class="divide-y divide-line border-y border-line [.tabs-on_&]:border-t-0">
              {g.faqs.map(([q, a], i) => (
                <details name={`faq-${g.id}`} open={i === 0}>
                  <summary class="flex w-full cursor-pointer list-none items-center justify-between gap-6 py-5 text-left text-lg font-medium">
                    {q}
                    <svg viewBox="0 0 16 16" class="faq-icon size-4 shrink-0 fill-none stroke-ocean" aria-hidden="true" focusable="false">
                      <path d="M3.5 6 8 10.5 12.5 6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </summary>
                  <p class="max-w-2xl pb-6 text-ink/75">{a}</p>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
