---
import { COUNTRIES } from "@kalea/shared";
import { COUNTRY_NAMES, DEMO_COUNTRIES } from "../../lib/catalog";
import StreetPerspective from "../ornaments/StreetPerspective.astro";
import StreetPlate from "../ornaments/StreetPlate.astro";

const words = ["Local", "ramps", "for", "LATAM,", "one", "API."];
// Demo corridors first, then the planned markets (same catalog as the Coverage section).
const markets = [...DEMO_COUNTRIES, ...COUNTRIES.filter((c) => !DEMO_COUNTRIES.includes(c))];
---

<section class="relative flex min-h-[88svh] items-center overflow-hidden bg-deep pb-14 pt-24">
  <!-- Offset street: the vanishing point sits right, so the copy on the left stays on a calm area. -->
  <!-- Below lg the copy spans the full width, so the lines are dimmed and the street is hidden. -->
  <div class="hero-parallax absolute inset-0 opacity-50 lg:opacity-100 [mask-image:linear-gradient(to_right,transparent_10%,black_65%)]">
    <StreetPerspective vx={0.8} vy={0.12} road={0.05} streetClass="hidden lg:inline" class="absolute inset-0 h-full w-full" />
  </div>
  <div class="hero-fade relative mx-auto w-full max-w-6xl px-4 sm:px-6">
    <div class="lg:max-w-[64%]">
      <span class="pop mb-6 inline-flex items-center gap-2 rounded-full border border-deep-line bg-deep-2/80 px-3 py-1 font-mono text-[11px] uppercase tracking-[0.14em] text-deep-soft">
        <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-apricot opacity-60"></span><span class="relative size-2 rounded-full bg-apricot"></span></span>
        Stellar testnet · B2B ramp infrastructure
      </span>
      <h1 class="text-[clamp(2.6rem,7vw,5.5rem)] font-bold leading-[0.95] tracking-tight">
        {words.map((w, i) => (
          <span class="mr-[0.22em] inline-block overflow-hidden pb-[0.08em] align-bottom">
            <span class:list={["rise", { "text-apricot": w === "LATAM," }]} style={`animation-delay:${0.15 + i * 0.07}s`}>{w}</span>
          </span>
        ))}
      </h1>
      <p class="fade-up mt-6 max-w-xl text-lg text-deep-soft" style="animation-delay:.8s">
        Embed fiat on-ramps, off-ramps and QR payments across Latin America. Independent merchants move local fiat under their own accounts; Kalea settles only USDC on Stellar through a per-order escrow.
      </p>
      <div class="fade-up mt-9 flex flex-wrap items-center gap-4" style="animation-delay:.95s">
        <a href="#quote" class="rounded-full bg-apricot px-6 py-3 font-semibold text-ink transition hover:-translate-y-0.5">Try a corridor quote</a>
        <a href="#how-it-works" class="group flex items-center gap-2 font-mono text-xs uppercase tracking-[0.14em] text-deep-soft hover:text-surface">
          How it works <span class="transition group-hover:translate-x-1">→</span>
        </a>
      </div>
      <div class="fade-up mt-10" style="animation-delay:1.1s">
        <p class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[11px] uppercase tracking-[0.14em] text-deep-muted">
          <span class="inline-flex items-center gap-2"><span aria-hidden="true" class="size-2.5 rounded-[3px] border-2 border-white bg-ocean"></span>Demo corridors</span>
          <span class="inline-flex items-center gap-2"><span aria-hidden="true" class="size-2.5 rounded-[3px] border-2 border-deep-muted/60"></span>Planned</span>
        </p>
        <ul class="mt-3 flex flex-wrap gap-2" aria-label="LATAM markets">
          {markets.map((c) => (
            <li><StreetPlate name={COUNTRY_NAMES[c]} tone="dark" planned={!DEMO_COUNTRIES.includes(c)} /></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
