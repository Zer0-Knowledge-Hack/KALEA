---
import RoadArrow from "../ornaments/RoadArrow.astro";
import StreetPerspective from "../ornaments/StreetPerspective.astro";
import { CONTACT_URL, btnGhostDark, btnPrimary, container } from "./styles";

const status = "First live network — USDC on Stellar testnet";
const lines = [
  { words: ["Ramps", "for", "LATAM", "businesses."], tone: "" },
  { words: ["Without", "the", "complexity."], tone: "text-deep-soft" },
];
const sub = "One API for on-ramps, off-ramps and QR payments across Latin America.";
const primary = "Get API access";
const secondary = "Book a demo";
---

<!-- The copy sits above the horizon; the street perspective owns the lower band and nothing covers it. -->
<section class="relative flex min-h-[100svh] flex-col bg-deep pt-16">
  <div class:list={[container, "hero-fade flex flex-1 flex-col justify-end pb-14 pt-16 sm:pt-20 lg:pb-16"]}>
    <p class="fade-up font-mono text-[11px] uppercase tracking-[0.2em] text-deep-muted" style="animation-delay:.1s">{status}</p>
    <h1 class="mt-7 max-w-[15ch] text-[clamp(2.75rem,6.6vw,5.75rem)] font-bold leading-[0.96] tracking-tight lg:max-w-none">
      {lines.map((line, l) => (
        <span class:list={["block", line.tone]}>
          {line.words.map((w, i) => (
            <span class="mr-[0.22em] inline-block overflow-hidden pb-[0.08em] align-bottom">
              <span class="rise" style={`animation-delay:${0.15 + (l * 4 + i) * 0.07}s`}>{w}</span>
            </span>
          ))}
        </span>
      ))}
    </h1>
    <div class="mt-10 grid gap-8 lg:grid-cols-12 lg:items-end">
      <p class="fade-up max-w-md text-lg text-deep-soft lg:col-span-5" style="animation-delay:.8s">{sub}</p>
      <div class="fade-up flex flex-wrap items-center gap-3 lg:col-span-6 lg:col-start-7 lg:justify-end" style="animation-delay:.95s">
        <a href="#developers" class={btnPrimary}>{primary} <RoadArrow kind="straight" class="size-4 rotate-90" /></a>
        <a href={CONTACT_URL} class={btnGhostDark}>{secondary}</a>
      </div>
    </div>
  </div>
  <!-- Horizon line, then the street rising to a centered vanishing point. -->
  <div class="relative h-[clamp(200px,34vh,380px)] w-full overflow-hidden border-t border-deep-line">
    <StreetPerspective vx={0.5} vy={0} road={0.07} lines={25} lineOpacity={0.2} class="absolute inset-0 h-full w-full" />
  </div>
</section>
