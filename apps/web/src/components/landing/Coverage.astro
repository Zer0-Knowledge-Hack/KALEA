---
import { COUNTRIES, COUNTRY_CATALOG } from "@kalea/shared";
import { COUNTRY_NAMES, DEMO_COUNTRIES, RAIL_NAMES } from "../../lib/catalog";
import { eyebrow } from "./styles";
---

<section id="coverage" class="mx-auto max-w-6xl px-4 py-28 sm:px-6">
  <p class={eyebrow}>LATAM coverage</p>
  <h2 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight sm:text-5xl">Local rails, one integration.</h2>
  <p class="mt-5 max-w-xl text-deep-soft">Each country has its own currency, rails and pricing. Corridors marked as demo have pricing on testnet today; the rest are next in line.</p>
  <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {COUNTRIES.map((c, i) => {
      const live = DEMO_COUNTRIES.includes(c);
      return (
        <div data-reveal style={`--delay:${i * 0.05}s`} class="rounded-3xl border border-deep-line p-6 transition-colors hover:border-apricot/40">
          <div class="flex items-center justify-between font-mono text-xs">
            <span class="text-apricot">{COUNTRY_CATALOG[c].currency}</span>
            <span class={live ? "text-apricot" : "text-deep-muted"}>{live ? "Demo corridor" : "Planned"}</span>
          </div>
          <h3 class="mt-6 text-xl font-semibold">{COUNTRY_NAMES[c]}</h3>
          <p class="mt-2 text-sm text-deep-soft">{COUNTRY_CATALOG[c].rails.map((r) => RAIL_NAMES[r]).join(" · ")}</p>
        </div>
      );
    })}
  </div>
</section>
