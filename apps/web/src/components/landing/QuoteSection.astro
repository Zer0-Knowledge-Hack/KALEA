---
import QuoteWidget from "../islands/QuoteWidget";
import { eyebrow } from "./styles";
---

<section id="quote" class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-28 sm:px-6 lg:grid-cols-2">
  <div data-reveal style="--from:translateX(-40px)">
    <p class={eyebrow}>Corridor quote demo</p>
    <h2 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">One price.<br /><span class="text-soft">The exact amount, every time.</span></h2>
    <p class="mt-5 max-w-md text-soft">Your product asks for a quote by country, side and rail. Kalea answers with one all-in rate and fixed amounts for your end user. Matching a merchant happens behind the API.</p>
    <dl class="mt-8 grid grid-cols-3 gap-4 border-t border-line pt-6">
      {[["5 min", "quote validity"], ["1", "all-in rate"], ["0", "Kalea fees to end users"]].map(([v, l]) => (
        <div><dt class="text-2xl font-bold">{v}</dt><dd class="font-mono text-[11px] uppercase tracking-wider text-mute">{l}</dd></div>
      ))}
    </dl>
  </div>
  <div data-reveal style="--from:translateY(40px) rotate(2deg)">
    <QuoteWidget client:visible />
  </div>
</section>
