---
import { REPO } from "./styles";
---

<section id="contact" class="px-4 pb-28 sm:px-6">
  <div class="grain relative mx-auto max-w-6xl overflow-hidden rounded-[2rem] bg-apricot px-6 py-20 text-center text-ink">
    <h2 class="mx-auto max-w-3xl text-4xl font-bold tracking-tight sm:text-6xl">Add LATAM ramps to your product with one API.</h2>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href={`${REPO}/issues`}
        data-magnetic
        class="inline-block rounded-full bg-deep px-8 py-4 font-semibold text-surface transition-transform duration-300 ease-[cubic-bezier(.34,1.56,.64,1)]"
      >
        Talk to us →
      </a>
      <a href={`${REPO}/tree/main/docs`} class="inline-block rounded-full border border-ink/30 px-8 py-4 font-semibold">Read the docs</a>
    </div>
  </div>
</section>
