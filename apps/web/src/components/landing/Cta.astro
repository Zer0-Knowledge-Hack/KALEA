---
import StreetPerspective from "../ornaments/StreetPerspective.astro";
import { REPO } from "./styles";
---

<!-- Dusk: the only gradient in the system. The footer skyline overlaps the bottom of this section. -->
<section id="contact" class="dusk relative overflow-hidden px-4 pb-40 pt-24 text-center text-white sm:px-6 sm:pb-52 sm:pt-28">
  <StreetPerspective vx={0.5} vy={0.7} street={false} lineOpacity={0.08} class="absolute inset-0 h-full w-full" />
  <div class="relative mx-auto max-w-6xl">
    <h2 class="mx-auto max-w-3xl text-4xl font-bold tracking-tight sm:text-6xl">Add LATAM ramps to your product with one API.</h2>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href={`${REPO}/issues`}
        data-magnetic
        class="inline-block rounded-full bg-apricot px-8 py-4 font-semibold text-ink transition-transform duration-300 ease-[cubic-bezier(.34,1.56,.64,1)]"
      >
        Talk to us →
      </a>
      <a href={`${REPO}/tree/main/docs`} class="inline-block rounded-full border border-white/50 px-8 py-4 font-semibold text-white hover:border-white">Read the docs</a>
    </div>
  </div>
</section>
