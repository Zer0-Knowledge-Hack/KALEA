---
/**
 * Crown divider: the three-point top edge of the mark repeated along a rule. Use as a section rule.
 * The path is drawn once for 2,160 units and cropped to the box width, so no pattern ids are needed.
 * Color follows `currentColor`. Decorative only.
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
const UNIT = 90;
const COUNT = 24;
let d = "M0,18";
for (let i = 0; i < COUNT; i++) {
  const x = i * UNIT;
  d += ` L${x + 30},18 L${x + 36},6 L${x + 42},12 L${x + 45},2 L${x + 48},12 L${x + 54},6 L${x + 60},18 L${x + UNIT},18`;
}
---

<svg viewBox={`0 0 ${UNIT * COUNT} 22`} preserveAspectRatio="xMinYMid slice" class:list={["pointer-events-none block h-[22px] w-full", className]} aria-hidden="true" focusable="false">
  <path d={d} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
</svg>
