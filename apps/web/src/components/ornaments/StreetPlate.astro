---
/** Street plate: a rounded sign reading "<Place> kalea" in mono. Live text, so it translates and stays accessible. */
interface Props {
  name: string;
  /** "dark" for Deep/Ocean backgrounds, "light" for white and Surface. */
  tone?: "dark" | "light";
  /** Planned markets use the quiet outline style. */
  planned?: boolean;
  class?: string;
}

const { name, tone = "dark", planned = false, class: className = "" } = Astro.props;

const look = {
  dark: planned ? "border-deep-muted/60 text-deep-soft" : "border-white bg-ocean text-white",
  light: planned ? "border-line bg-white text-muted" : "border-ocean bg-white text-ocean",
}[tone];
---

<span class:list={["inline-flex items-center whitespace-nowrap rounded-control border-[2.5px] px-3 py-1 font-mono text-[13px] font-medium leading-5", look, className]}>
  {name} kalea{planned && <span class="sr-only"> (planned)</span>}
</span>
