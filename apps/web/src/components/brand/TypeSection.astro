---
/** Typography: the three self-hosted families with specimens set in the fonts the site already loads. */
import { useTranslations, type Locale } from "../../i18n";
import { container, eyebrow, h2, sectionY } from "../landing/styles";

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale).brand.typography;
// Family names, weights and the mono specimen are not translated.
const families = [
  { key: "display", family: "Funnel Display", weights: "700", sample: t.families.display.sample, class: "font-display text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl" },
  { key: "text", family: "Golos Text", weights: "400 · 500 · 600", sample: t.families.text.sample, class: "font-text text-xl sm:text-2xl" },
  { key: "mono", family: "Sometype Mono", weights: "400 · 500", sample: "#1E578F · 0123456789", class: "font-mono text-lg tabular-nums sm:text-xl" },
] as const;
---

<section id="typography" class="scroll-mt-6 bg-deep text-white">
  <div class:list={[container, sectionY]}>
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class={eyebrow}>{t.eyebrow}</p>
        <h2 class:list={[h2, "mt-5"]}>{t.headline}</h2>
      </div>
      <p class="max-w-md text-lg text-deep-soft lg:col-span-5">{t.sub}</p>
    </div>

    <ol class="mt-16 divide-y divide-deep-line border-y border-deep-line">
      {families.map((f) => {
        const copy = t.families[f.key];
        return (
          <li class="grid gap-6 py-10 lg:grid-cols-12">
            <div class="lg:col-span-4">
              <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-apricot">{copy.role}</p>
              <p class="mt-3 text-2xl font-semibold">{f.family}</p>
              <p class="mt-2 text-sm text-deep-soft">{copy.use}</p>
              <p class="mt-3 font-mono text-xs text-deep-muted">{t.weightsLabel}: {f.weights}</p>
            </div>
            <p class:list={["break-words lg:col-span-8", f.class]}>{f.sample}</p>
          </li>
        );
      })}
    </ol>
    <p class="mt-8 max-w-2xl text-deep-soft">{t.tabular}</p>
  </div>
</section>
