---
/** Color: the six brand colors with hex, role, usage and contrast against white. Values from brand/tokens.json. */
import { LOCALE_META, useTranslations, type Locale } from '../../i18n';
import { container, eyebrowLight, h2, sectionY } from '../landing/styles';
import { SWATCHES } from './assets';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale).brand.color;
const ratio = (value: string) =>
  `${Number(value).toLocaleString(LOCALE_META[locale].intl, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}:1`;
---

<section id="color" class="scroll-mt-6 bg-white text-ink">
  <div class:list={[container, sectionY]}>
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class={eyebrowLight}>{t.eyebrow}</p>
        <h2 class:list={[h2, 'mt-5']}>{t.headline}</h2>
      </div>
      <p class="max-w-md text-lg text-ink/75 lg:col-span-5">{t.sub}</p>
    </div>

    <ul class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {SWATCHES.map((s) => {
        const copy = t.swatches[s.key];
        return (
          <li class="overflow-hidden rounded-card border border-line">
            <!-- The hex on the swatch uses Ink or white, whichever passes 4.5:1 on that color. -->
            <div
              class:list={['flex h-36 items-end justify-between p-5', s.fg]}
              style={`background:${s.hex}`}
            >
              <span class="font-display text-2xl font-bold tracking-tight">{s.name}</span>
              <span class="font-mono text-sm">{s.hex}</span>
            </div>
            <div class="p-5">
              <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-ocean">
                {copy.role}
              </p>
              <p class="mt-2 text-sm text-ink/80">{copy.use}</p>
              <p class="mt-4 flex items-baseline justify-between gap-4 border-t border-line pt-3 text-sm">
                <span>{copy.text}</span>
                <span class="whitespace-nowrap font-mono text-muted">
                  {t.contrastLabel} {ratio(s.vsWhite)}
                </span>
              </p>
            </div>
          </li>
        );
      })}
    </ul>

    <!-- The Apricot rule, shown the safe way: Apricot as a painted line beside Ink text, never as the text color. -->
    <p class="mt-12 max-w-3xl border-l-4 border-apricot pl-4 text-lg font-semibold">
      {t.apricotRule}
    </p>
    <p class="mt-6 max-w-3xl text-ink/75">{t.threshold}</p>
    <p class="mt-2 max-w-3xl text-ink/75">{t.tokens}</p>
  </div>
</section>
